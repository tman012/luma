# Luma configuration. Copy to .env (chmod 600) and fill in what you use.
# Everything here is optional unless noted; most service settings can also be
# entered later in Settings.

# ---- Server / container ----
LUMA_PORT=5001
TZ=UTC
# LUMA_IMAGE=luma:latest
# LUMA_CONTAINER_NAME=luma
# Public URL used in e-mail and Telegram links (blank = the URL of the request)
APP_URL=
# Flask session key (required: any long random string)
SECRET_KEY=

# ---- Host folders mounted into the container (defaults: ./data, ./media/...) ----
# Host side only. Inside the container the app always uses LUMA_DATA_DIR=/app/data
# and LUMA_CACHE_DIR=/app/cache (set in docker-compose.yml); don't set those here.
LUMA_DATA_HOST_DIR=./data
LUMA_CACHE_HOST_DIR=./cache
LUMA_ADB_KEYS_DIR=./.android
LUMA_DOWNLOADS_DIR=./media/downloads
LUMA_MOVIES_DIR=./media/movies
LUMA_RECENT_DIR=./media/recent
LUMA_TV_DIR=./media/tv
LUMA_4K_DIR=./media/4k
LUMA_FULLRIPS_DIR=./media/fullrips
LUMA_TV_4K_DIR=./media/tv-4k
LUMA_TV_REMUX_DIR=./media/tv-remux
# Optional read-only Plex database folder; PLEX_DB = path of the .db inside the container
LUMA_PLEX_DB_DIR=./plexdb
PLEX_DB=

# ---- API keys ----
TMDB_API_KEY=
OMDB_API_KEY=
FANART_API_KEY=
YT_INNERTUBE_KEY=

# ---- Plex ----
PLEX_URL=
PLEX_TOKEN=
PLEX_ACCOUNT_ID=1
PLEX_MACHINE_ID=

# ---- Sonarr / Radarr ----
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=

# ---- Devices ----
# Android TV / Shield IP used to seed the first room on first start (optional)
SHIELD_PLEX_IP=
# Kodi: share root for file URLs when no Kodi source covers a path, e.g. smb://nas
KODI_NAS_BASE=

# ---- Notifications ----
# Gmail (account-approval e-mails)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Telegram admin alerts (bot token goes in data/telegram_bot.json)
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ACTION_SECRET=

# ---- Companion apps ----
# Service-to-service API key (X-API-Key) that other apps use to read rooms
SERVICE_API_KEY=

# ---- Admin seed (optional; unset = no seeded admin) ----
LUMA_ADMIN_NAME=
LUMA_ADMIN_EMAIL=
LUMA_ADMIN_PIN=

# ---- Local HTTPS proxy CA (optional) ----
# Path inside the container of a CA root cert to serve at /ca.crt
LUMA_CA_CERT_PATH=

# ---- Dev instance only (docker-compose.dev.yml) ----
# LUMA_DEV_PORT=5199
# LUMA_DEV_DATA_DIR=./.dev-data
# Comma-separated upstream base URLs the dev instance may only READ from
# (non-GET requests are refused locally), e.g. your Plex, Radarr and Sonarr URLs.
LUMA_READ_ONLY_URLS=
