# =====================================================================
# Luma (media-search-app) — git ignore
# Goal: back up source only. Secrets, runtime data, caches and build
# output stay on the server (see data backup notes).
# =====================================================================

# ---- Secrets / credentials (NEVER commit) ----
.env
.env.*
!.env.example
settings.json
**/settings.json
**/settings-backup.json*
alfred/users.json
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
cookies*.txt
*.cookies
.android/
**/.android/
android-kiosk/local.properties

# ---- Runtime data (databases, state, logs) ----
/data/
alfred/data/
/config/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
logs/
download_monitor.json
download_history.json

# ---- Caches ----
/cache/
/tmp/
static/hero_cache/
**/plex_cache/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Python envs ----
venv/
.venv/
/env/
.Python
*.so

# ---- Node / frontend build output (rebuilt by `npm run build` / Docker stage 1) ----
node_modules/
frontend/dist/
static/spa/
*.tsbuildinfo
.vite/

# ---- Android build output (source IS tracked) ----
android-kiosk/.gradle/
android-kiosk/build/
android-kiosk/app/build/
android-tv/**/build/
android-tv/.gradle/
*.apk
*.aab
*.dex

# ---- Backups / scratch copies (often contain old hardcoded keys) ----
*.bak
*.bak2
*.bak.*
*.bak-*
*.orig
*.rej

# ---- Agent / editor / OS ----
.claude/
**/.claude/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Large third-party speech models (public download: Vosk small en-us) ----
static/models/
android-kiosk/app/src/main/assets/model-en-us/
